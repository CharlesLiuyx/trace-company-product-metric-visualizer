{
  "schemaVersion": 1,
  "contractStatus": "accepted-target-with-migration-status-in-README",
  "currentImplementationStatusDocument": "docs/architecture/README.md#migration-milestones",
  "protocols": {
    "datasetBuild": "dataset-build/v1",
    "fidelityRun": "fidelity-run/2",
    "sourceClassification": "source-classification/v1",
    "sourceObjects": "source-objects/v1",
    "verificationPlan": "verification-plan/v6",
    "reviewPacket": "review-packet/v5",
    "datasetVerification": "dataset-verification/v1",
    "fidelityResult": "fidelity-result/v3",
    "publication": "dataset-publication/v2",
    "sourceFacts": "source-facts/v1",
    "textSourceClassification": "source-classification/v2",
    "metricObservations": "metric-observations/v1",
    "artifactManifest": "artifact-manifest/v1",
    "checkpoint": "fidelity-checkpoints/v1",
    "reviewCandidate": "review-candidate/v1",
    "releaseAttempt": "release-attempt/v1",
    "session": "workflow-session/v1",
    "gitTransport": "git-transport/v1",
    "workbench": "trace-workbench/v1",
    "workflowTimestamps": "workflow-timestamps/v1",
    "application": "workflow-application/v1",
    "recordStorage": "trace-record-list/v1",
    "workspaceStorage": "workspace-storage/v1"
  },
  "operationClasses": {
    "verify": "canonical-read-only",
    "record": "build-local-write",
    "publish": "canonical-compare-and-swap",
    "release": "published-digest-only"
  },
  "scopes": {
    "DatasetBuild": {
      "states": [
        "INTAKED",
        "AUTHORED",
        "CLOSED",
        "BASELINE_STAGED",
        "SEALED"
      ],
      "transitions": [
        [
          "INTAKED",
          "AUTHORED"
        ],
        [
          "CLOSED",
          "AUTHORED"
        ],
        [
          "BASELINE_STAGED",
          "AUTHORED"
        ],
        [
          "SEALED",
          "AUTHORED"
        ],
        [
          "AUTHORED",
          "CLOSED"
        ],
        [
          "CLOSED",
          "BASELINE_STAGED"
        ],
        [
          "BASELINE_STAGED",
          "SEALED"
        ]
      ]
    },
    "PublicationBatch": {
      "states": [
        "PLANNED",
        "PUBLISHED",
        "CONFLICTED"
      ],
      "transitions": [
        [
          "PLANNED",
          "PUBLISHED"
        ],
        [
          "PLANNED",
          "CONFLICTED"
        ]
      ],
      "conflictRecovery": "new-plan-reverify-reseal"
    },
    "ReleaseAttempt": {
      "states": [
        "PENDING",
        "RELEASED",
        "RELEASE_FAILED"
      ],
      "transitions": [
        [
          "PENDING",
          "RELEASED"
        ],
        [
          "PENDING",
          "RELEASE_FAILED"
        ]
      ],
      "retryCreatesNewAttempt": true
    }
  },
  "adapters": [
    "income-statement",
    "revenue-metric",
    "metric-observation"
  ],
  "sourceClassification": {
    "reviewMethod": "full-source-type-gate",
    "signals": [
      "income-statement-values",
      "sankey-flow-topology",
      "revenue-metric-definition",
      "time-series-observations",
      "metric-observations",
      "supplemental-operating-metrics"
    ],
    "requiredBeforeFreshRecordIntake": true,
    "bindsWholeNativeSource": true,
    "derivedAdapterMustMatchRequestedAdapter": true
  },
  "sourceObjects": {
    "objectClasses": [
      "value",
      "flow",
      "label",
      "asset",
      "residual"
    ],
    "amountUnits": [
      "K",
      "M",
      "B",
      "T"
    ],
    "incomeStatementSsotPaths": [
      "revenue.total",
      "revenue.items",
      "revenue.breakdowns",
      "revenue.paymentNetwork.gross",
      "revenue.paymentNetwork.grossItems",
      "revenue.paymentNetwork.rebates",
      "costs.costOfRevenue",
      "costs.costOfRevenue.items",
      "costs.operatingExpenses.total",
      "costs.operatingExpenses.items",
      "costs.tax",
      "operatingOtherIncome.total",
      "operatingOtherIncome.items",
      "operatingOtherExpenses.total",
      "operatingOtherExpenses.items",
      "otherIncome.total",
      "otherIncome.items",
      "otherExpenses.total",
      "otherExpenses.items",
      "profit.gross",
      "profit.gross.items",
      "profit.operating",
      "profit.operating.items",
      "profit.net"
    ],
    "authoritativeCorrectionApproval": "user-directed-source-correction",
    "amountWithinLiteralResolution": true,
    "otherLabelsMayBeNonSemanticResidual": false,
    "valueBearingOtherMustBeValue": true,
    "roundedNonZeroMayBeAuthoredAsZero": false,
    "recoveredNonZeroMustSurviveAuthoredDisplayPrecision": true,
    "prepareReviewReconcilesLoadedAuthoredValues": true,
    "incomeStatementFinancialViewOwnership": "exactly-one-node-or-non-node-metric",
    "adapterTargetOwnership": "exactly-once",
    "sourcePixelEvidence": false,
    "subFloorNodeDeclaration": "shortNodes",
    "labelPositionAudit": "opt-in-referenceBBox",
    "incomeStatementReconciliationTargets": [
      "metric-ssot",
      "sankey-view-adapter"
    ],
    "revenueMetricReconciliationTargets": [
      "metric-ssot"
    ],
    "supplementalOperatingMetrics": {
      "ssotPath": "operatingMetrics",
      "viewPath": "operatingMetrics",
      "sourceClass": "value",
      "units": [
        "K",
        "M",
        "B",
        "T",
        "%",
        "count"
      ],
      "comparisons": [
        "eq",
        "gt",
        "gte",
        "lt",
        "lte"
      ],
      "participatesInAccountingSums": false,
      "dedicatedVisibleValueText": true
    }
  },
  "nodeFaceExpectations": {
    "derivedFrom": "source-objects/v1",
    "valueNodesExpectedVisible": true,
    "everyRenderedNodePainted": true,
    "subFloorExceptions": "shortNodes"
  },
  "sankeyAdapter": {
    "semanticNodesRequirePaintedFaces": true,
    "explicitTransparentSemanticNodesAllowed": false,
    "nonNodeMetricRepresentations": [
      "annotation",
      "data-only",
      "flow"
    ],
    "routeGeometryOwnership": "link-owned",
    "routesProduceNodePaintAuditRows": false
  },
  "sourceAvailability": [
    "public",
    "local-only",
    "restricted"
  ],
  "sourceLocations": {
    "pending": "unclaimed",
    "processing": "build-local-working-locator",
    "processed": "operator-managed-stable-locator",
    "processingIsDatasetBuildState": false,
    "operatorCompletionSignals": [
      "human-review-complete",
      "pushed-and-merged-to-main"
    ],
    "operatorSignalAppliesToAllProcessing": true,
    "operatorRelocationListBoundToSignalScope": true,
    "operatorSignalIsOnlyRelocationTrigger": true,
    "operatorRelocationMustNotClobber": true
  },
  "changeImpact": [
    "new-dataset",
    "geometry",
    "render-engine",
    "interaction",
    "localized-layout",
    "display-text-only",
    "asset",
    "financial-data-only",
    "company-metadata-only",
    "docs-only"
  ],
  "durableObjects": [
    "ChangeImpact",
    "SourceClassification",
    "SourceObjects",
    "VerificationPlan",
    "DatasetVerification",
    "ArtifactManifest",
    "FidelityResult",
    "FeedbackNote",
    "ReviewPacket"
  ],
  "invariants": {
    "baselinePurpose": "future-regression-only",
    "baselineMayProveProducingBuild": false,
    "releaseFailureRollsBackPublication": false,
    "publicationConflictRetryableWithoutNewPlan": false,
    "automaticEvidenceMayCloseBuild": false,
    "humanAttestationRequiredForIncomeStatement": true,
    "verifyCommandsWriteDurableEvidence": false,
    "sourceRelocationChangesIdentity": false
  },
  "workflow": {
    "owner": "docs/asset-workflow.md",
    "sourceFormats": [
      "png",
      "txt",
      "md"
    ],
    "newBuildsIsolated": true,
    "draftsUseExistingBuildLedger": true,
    "canonicalVisibility": "immutable-tree-with-atomic-pointer",
    "readerPinsPublishedDigest": true,
    "legacyBuildsAreNotAutoUpgraded": true
  }
}
