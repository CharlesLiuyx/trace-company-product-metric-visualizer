{
  "schemaVersion": 1,
  "contractStatus": "accepted-target-with-migration-status-in-README",
  "currentImplementationStatusDocument": "docs/architecture/README.md#migration-milestones",
  "protocols": {
    "datasetBuild": "dataset-build/v1",
    "fidelityRun": "fidelity-run/2",
    "sourceClassification": "source-classification/v1",
    "sourceCoverage": "source-coverage/v2",
    "objectInventory": "object-inventory/v4",
    "nodeFacePolicy": "node-face-policy/v2",
    "verificationPlan": "verification-plan/v5",
    "reviewPacket": "review-packet/v4",
    "datasetVerification": "dataset-verification/v1",
    "interfaceMatrix": "interface-matrix/v1",
    "fidelityResult": "fidelity-result/v2",
    "publication": "dataset-publication/v1"
  },
  "operationClasses": {
    "verify": "canonical-read-only",
    "record": "build-local-write",
    "publish": "canonical-compare-and-swap",
    "release": "published-digest-only"
  },
  "scopes": {
    "DatasetBuild": {
      "states": [
        "INTAKED",
        "AUTHORED",
        "CLOSED",
        "BASELINE_STAGED",
        "SEALED"
      ],
      "transitions": [
        ["INTAKED", "AUTHORED"],
        ["CLOSED", "AUTHORED"],
        ["BASELINE_STAGED", "AUTHORED"],
        ["SEALED", "AUTHORED"],
        ["AUTHORED", "CLOSED"],
        ["CLOSED", "BASELINE_STAGED"],
        ["BASELINE_STAGED", "SEALED"]
      ]
    },
    "PublicationBatch": {
      "states": ["PLANNED", "PUBLISHED", "CONFLICTED"],
      "transitions": [
        ["PLANNED", "PUBLISHED"],
        ["PLANNED", "CONFLICTED"]
      ],
      "conflictRecovery": "new-plan-reverify-reseal"
    },
    "ReleaseAttempt": {
      "states": ["PENDING", "RELEASED", "RELEASE_FAILED"],
      "transitions": [
        ["PENDING", "RELEASED"],
        ["PENDING", "RELEASE_FAILED"]
      ],
      "retryCreatesNewAttempt": true
    }
  },
  "adapters": ["income-statement", "revenue-metric"],
  "sourceClassification": {
    "reviewMethod": "full-source-type-gate",
    "signals": [
      "income-statement-values",
      "sankey-flow-topology",
      "revenue-metric-definition",
      "time-series-observations"
    ],
    "requiredBeforeFreshRecordIntake": true,
    "bindsWholeNativeSource": true,
    "derivedAdapterMustMatchRequestedAdapter": true
  },
  "sourceCoverage": {
    "scanPasses": ["geometry", "residual", "semantic-value"],
    "objectClasses": [
      "financial-value",
      "metric-observation",
      "structural-flow",
      "label-or-annotation",
      "asset-or-brand",
      "non-semantic-residual"
    ],
    "residualKinds": [
      "publisher-attribution",
      "creator-branding",
      "website-url",
      "social-badge",
      "decorative-residue"
    ],
    "amountUnits": ["K", "M", "B", "T"],
    "incomeStatementSsotPaths": [
      "revenue.total",
      "revenue.items",
      "revenue.breakdowns",
      "revenue.paymentNetwork.gross",
      "revenue.paymentNetwork.grossItems",
      "revenue.paymentNetwork.rebates",
      "costs.costOfRevenue",
      "costs.costOfRevenue.items",
      "costs.operatingExpenses.total",
      "costs.operatingExpenses.items",
      "costs.tax",
      "operatingOtherIncome.total",
      "operatingOtherIncome.items",
      "operatingOtherExpenses.total",
      "operatingOtherExpenses.items",
      "otherIncome.total",
      "otherIncome.items",
      "otherExpenses.total",
      "otherExpenses.items",
      "profit.gross",
      "profit.gross.items",
      "profit.operating",
      "profit.operating.items",
      "profit.net"
    ],
    "precisionRecoveryMethod": "authoritative-supplemental-source",
    "authoritativeCorrectionMethod": "authoritative-source-correction",
    "authoritativeCorrectionApproval": "user-directed-source-correction",
    "authoritativeCorrectionIssues": ["unit-typo", "numeric-typo"],
    "amountWithinLiteralResolution": true,
    "inventoryOwnership": "exactly-once",
    "otherLabelsMayBeNonSemanticResidual": false,
    "zeroLookingNumericTypoRequiresAuthoritativeCorrection": true,
    "roundedNonZeroMayBeAuthoredAsZero": false,
    "recoveredNonZeroMustSurviveAuthoredDisplayPrecision": true,
    "prepareReviewReconcilesLoadedAuthoredValues": true,
    "incomeStatementFinancialViewOwnership": "exactly-one-node-or-non-node-metric",
    "semanticNodesRequireObservedFace": true,
    "invisibleSemanticNodesSupported": false,
    "incomeStatementNonNodeMetricsRequireZeroPaintEvidence": true,
    "prepareReviewPixelChecksZeroPaintNodeSlots": true,
    "incomeStatementReconciliationTargets": ["metric-ssot", "sankey-view-adapter"],
    "revenueMetricReconciliationTargets": ["metric-ssot"]
  },
  "nodeFacePolicy": {
    "derivedFrom": "source-coverage/v2",
    "embeddedIn": "verification-plan/v5",
    "completeRenderedNodeClassification": true,
    "allCurrentSemanticNodesExpectedVisible": true,
    "sourceBoundFloorExceptionsOnly": true
  },
  "sankeyAdapter": {
    "semanticNodesRequirePaintedFaces": true,
    "explicitTransparentSemanticNodesAllowed": false,
    "nonNodeMetricRepresentations": ["annotation", "data-only", "flow"],
    "routeGeometryOwnership": "link-owned",
    "routesProduceNodePaintAuditRows": false
  },
  "sourceAvailability": ["public", "local-only", "restricted"],
  "sourceLocations": {
    "pending": "unclaimed",
    "processing": "build-local-working-locator",
    "processed": "operator-managed-stable-locator",
    "processingIsDatasetBuildState": false,
    "operatorCompletionSignals": [
      "human-review-complete",
      "pushed-and-merged-to-main"
    ],
    "operatorSignalAppliesToAllProcessing": true,
    "operatorRelocationRequiresPreMoveListConfirmation": true,
    "operatorSignalIsOnlyRelocationTrigger": true,
    "operatorRelocationMustNotClobber": true
  },
  "changeImpact": [
    "new-dataset",
    "geometry",
    "render-engine",
    "interaction",
    "localized-layout",
    "display-text-only",
    "asset",
    "financial-data-only",
    "company-metadata-only",
    "docs-only"
  ],
  "durableObjects": [
    "ChangeImpact",
    "SourceClassification",
    "SourceCoverage",
    "VerificationPlan",
    "DatasetVerification",
    "ArtifactManifest",
    "InterfaceMatrix",
    "FidelityResult",
    "ObjectInventory",
    "ManualAttestation",
    "RegionDecision",
    "FeedbackRecord",
    "FeedbackLedger",
    "NodeFacePolicy",
    "ReviewPacket"
  ],
  "invariants": {
    "baselinePurpose": "future-regression-only",
    "baselineMayProveProducingBuild": false,
    "releaseFailureRollsBackPublication": false,
    "publicationConflictRetryableWithoutNewPlan": false,
    "automaticEvidenceMayCloseBuild": false,
    "humanAttestationRequiredForIncomeStatement": true,
    "verifyCommandsWriteDurableEvidence": false,
    "sourceRelocationChangesIdentity": false
  }
}
