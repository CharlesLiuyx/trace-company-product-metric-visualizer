.DS_Store
node_modules/
_site/
.playwright-cli/
.claude/worktrees/
__pycache__/
*.py[cod]
compare/*
!compare/.gitkeep
output/*
.artifact-cleanup.lock
output/compare/

input/**
!input/**/
!input/**/.gitkeep
!input/README.md
!input/**/README.md

# Shared Source queues: keep new work and active claims visible to Git.
!input/pending/**
!input/processing/**

# Completed references are a local archive and must never be committed.
input/processed/**
!input/processed/.gitkeep
input/**/.DS_Store

# Crop recipes are durable metadata; reference PNGs remain local-only.
!input/icon-crop-specs/*.json
