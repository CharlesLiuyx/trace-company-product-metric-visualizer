      "validation": {
        "borderBand": 0,
        "maxCenterOffset": 0.1,
        "maxForbiddenForegroundPixels": 0
      },
      "note": "Television brand cluster: Fox, Fox TV Stations, MyNetworkTV, Tubi; excludes the segment label, values, margin text, and flow marks."
    }
  ]
}
