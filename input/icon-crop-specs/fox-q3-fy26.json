      "cropBox": { "x": 4, "y": 315, "width": 224, "height": 256 },
      "threshold": 10,
      "minComponentArea": 18,
      "excludeBoxes": [
        { "x": 176, "y": 372, "width": 54, "height": 50 },
        { "x": 196, "y": 424, "width": 34, "height": 84 }
