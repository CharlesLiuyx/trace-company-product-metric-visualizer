{
  "source": "input/processed/nu-q4-fy25.png",
  "outputDir": "data/assets/icon-references/nu",
  "validationSheetDir": "data/assets/icon-references/nu/validation-sheets",
  "report": "crop-report.json",
  "background": [242, 242, 242],
  "backgroundRemoval": {
    "enabled": true,
    "mode": "edge-connected",
    "tolerance": 8
