    {
      "key": "nu-credit-card-cluster",
      "output": "crops/credit-card-cluster.png",
      "searchBox": { "x": 112, "y": 244, "width": 205, "height": 194 },
      "cropBox": { "x": 103, "y": 238, "width": 222, "height": 207 },
      "threshold": 14,
      "minComponentArea": 20,
      "validation": {
        "maxCenterOffset": 0.12
      },
      "note": "Two Nu credit cards tied to the Credit card interest-income source; excludes the nearby amount, label, and title."
    }
  ],
  "skipped": [
    {
      "key": "publisher-how-they-make-money",
      "reason": "Source publisher branding and not part of Nu's income-statement semantics."
    },
    {
      "key": "publisher-website",
