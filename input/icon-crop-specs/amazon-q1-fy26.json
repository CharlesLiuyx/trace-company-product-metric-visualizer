{
  "source": "input/processed/amazon-q1-fy26.png",
  "outputDir": "data/assets/icon-references/amazon",
  "validationSheetDir": "data/assets/icon-references/amazon/validation-sheets",
  "report": "crop-report.json",
  "background": [242, 242, 242],
  "backgroundRemoval": {
    "enabled": true,
    "mode": "edge-connected",
    "tolerance": 8
  },
  "crops": [
    {
      "key": "amazon-company-wordmark",
      "output": "crops/company-wordmark.png",
      "searchBox": { "x": 690, "y": 276, "width": 500, "height": 170 },
      "cropBox": { "x": 684, "y": 268, "width": 514, "height": 186 },
      "threshold": 18,
      "minComponentArea": 45,
      "note": "Amazon company wordmark above the revenue hub; excludes title, values, flows, and publisher marks."
    },
    {
      "key": "amazon-business-online-stores",
      "output": "crops/business-online-stores.png",
      "searchBox": { "x": 98, "y": 424, "width": 238, "height": 56 },
      "cropBox": { "x": 88, "y": 415, "width": 260, "height": 73 },
      "threshold": 18,
      "minComponentArea": 35,
      "note": "amazon.com logo for Online Stores only; excludes the Online Stores label, values, and flow marks."
    },
    {
      "key": "amazon-business-physical-store",
      "output": "crops/business-physical-store.png",
      "searchBox": { "x": 88, "y": 568, "width": 260, "height": 84 },
      "cropBox": { "x": 80, "y": 568, "width": 280, "height": 96 },
      "threshold": 18,
      "minComponentArea": 35,
      "validation": {
        "borderBand": 0,
        "maxCenterOffset": 0.09,
        "maxForbiddenForegroundPixels": 0
      },
      "note": "Fresh and Whole Foods business cluster only; excludes the Physical Store label, values, and flow marks."
    },
    {
      "key": "amazon-business-advertising",
      "output": "crops/business-advertising.png",
      "searchBox": { "x": 74, "y": 900, "width": 260, "height": 76 },
      "cropBox": { "x": 66, "y": 898, "width": 278, "height": 86 },
      "threshold": 18,
      "minComponentArea": 35,
      "validation": {
        "borderBand": 0,
        "maxCenterOffset": 0.14,
        "maxForbiddenForegroundPixels": 0
      },
      "note": "Amazon Ads and Twitch cluster for Advertising only; excludes the Advertising label, values, and flow marks."
    },
    {
      "key": "amazon-business-subscription",
      "output": "crops/business-subscription.png",
      "searchBox": { "x": 105, "y": 1056, "width": 260, "height": 66 },
      "cropBox": { "x": 96, "y": 1054, "width": 278, "height": 78 },
      "threshold": 18,
      "minComponentArea": 35,
      "validation": {
        "borderBand": 0,
        "maxCenterOffset": 0.06,
        "maxForbiddenForegroundPixels": 0
      },
      "note": "Prime and Audible business cluster for Subscription only; excludes the Subscription label, values, and flow marks."
    },
    {
      "key": "amazon-business-aws-left",
      "output": "crops/business-aws-left.png",
      "searchBox": { "x": 186, "y": 1150, "width": 176, "height": 116 },
      "cropBox": { "x": 178, "y": 1152, "width": 192, "height": 132 },
      "threshold": 18,
      "minComponentArea": 35,
      "note": "AWS business mark for the revenue line only; excludes revenue values, the Other line, and flow marks."
    },
    {
      "key": "amazon-business-aws-callout",
      "output": "crops/business-aws-callout.png",
      "searchBox": { "x": 1740, "y": 544, "width": 82, "height": 58 },
      "cropBox": { "x": 1738, "y": 544, "width": 86, "height": 62 },
      "threshold": 18,
      "minComponentArea": 25,
      "validation": {
        "borderBand": 0,
        "maxCenterOffset": 0.06,
        "maxForbiddenForegroundPixels": 0
      },
      "note": "Small AWS mark inside the operating-profit callout; excludes the value, Other text, and callout border."
    }
  ]
}
